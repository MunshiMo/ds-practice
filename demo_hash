class HashTable:
    def __init__(self, capacity=8):
        self.capacity = capacity
        self.length = 0            # number of key-value pairs stored
        self.buckets = [[] for _ in range(capacity)]  # each bucket is a list of [key, value] pairs

    def _hash(self, key):
        # turn key into an index within self.capacity
         #  return abs(hash(key) % self.capacity)
         # dont need abs because modulo already only returns a positive number
         return hash(key) % self.capacity

    def set(self, key, value):
        # hash the key to find the bucket
        
        # check if key already exists in that bucket -> update it
        # otherwise -> add a new [key, value] pair
        
        space_bucket = self._hash(key)
        position_in_mem = self.buckets[space_bucket]
        
        #where the key is, there is a list of data so we need to iterate through this list and find if the key already exists there
